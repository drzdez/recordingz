<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Recordingz.Capture</RootNamespace>
    <AssemblyName>recordingz-capture</AssemblyName>
    <Version>2.0.4</Version>
    <InvariantGlobalization>false</InvariantGlobalization>
    <!-- window capture measures and grabs in physical pixels on every monitor, whatever its scale -->
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Tomlyn" Version="2.10.1" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Settings\settings.html" LogicalName="settings.html" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Recordingz.Capture.Tests" />
  </ItemGroup>

</Project>
