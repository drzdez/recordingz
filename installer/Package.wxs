<?xml version="1.0" encoding="utf-8"?>
<!--
  recordingz: per-user MSI, no admin rights. With SuiteDir (stage-suite.ps1) it is the whole suite: next to the recording
  app the review window (recordingz-review.exe), uv.exe and transcribe\ (the transcribe part, the Python project); the window
  builds the Python environment from them on its first start (%LOCALAPPDATA%\recordingz\env, outside this folder, so an
  update keeps it and the window only refreshes it). Without SuiteDir: the recording app alone, as before.

  It installs into %LOCALAPPDATA%\Programs\recordingz (the same
  folder as the manual install before, so an upgrade replaces it in place), a Start menu shortcut and a Startup
  shortcut (autostart at login). A newer MSI upgrades an older one.

  Before the files are replaced a running app is asked to quit (quit.request next to the exe, see App/QuitRequest.cs).
  The app refuses during a recording; the install then stops with an error and can be run again after the meeting.
  After the install the app is started again (LAUNCHAPP=0 to skip).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package Name="recordingz"
           Manufacturer="drzdez"
           Version="$(ProductVersion)"
           UpgradeCode="6f1d2c3e-8a4b-4e57-9a0c-2b7d5e1f3a91"
           Scope="perUser"
           Compressed="yes">

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/drzdez/recordingz" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <Property Id="LAUNCHAPP" Value="1" />

    <!-- a plain per-user package has no per-user Program Files: %LOCALAPPDATA%\Programs explicitly -->
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="ProgramsFolder" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="recordingz">
          <Directory Id="TRANSCRIBEFOLDER" Name="transcribe" />
          <Directory Id="FFMPEGFOLDER" Name="ffmpeg" />
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- The recordings folder, asked on the folder page (FolderUI.wxs). Default: the folder the app last used
         (OutDirCurrent, written by the app), else %USERPROFILE%\meetings – in the profile, so always writable without
         admin rights. Placed under the profile here only to have a Directory row; the value comes from SetProperty.
         The app writes the choice into the shared TOML (Config/InstallerFolder.cs). The saved folder is used only on
         a fresh install: a bad value there (another drive, error 1606) must never block an upgrade or uninstall. -->
    <StandardDirectory Id="PersonalFolder">
      <Directory Id="OUTDIR" Name="meetings" />
    </StandardDirectory>
    <Property Id="OUTDIR_CURRENT">
      <RegistrySearch Id="OutDirCurrent" Root="HKCU" Key="Software\recordingz\capture" Name="OutDirCurrent" Type="raw" />
    </Property>
    <SetProperty Id="OUTDIR" Action="SetOutDirCurrent" Value="[OUTDIR_CURRENT]" Before="CostInitialize" Sequence="first"
                 Condition="NOT OUTDIR AND OUTDIR_CURRENT AND NOT Installed AND NOT WIX_UPGRADE_DETECTED" />
    <SetProperty Id="OUTDIR" Action="SetOutDirDefault" Value="[%USERPROFILE]\meetings" Before="CostInitialize"
                 Sequence="first" Condition="NOT OUTDIR AND NOT OUTDIR_CURRENT" />
    <Property Id="WIXUI_INSTALLDIR" Value="OUTDIR" />
    <UIRef Id="RecordingzUI" />

    <ComponentGroup Id="App" Directory="INSTALLFOLDER">
      <Component Id="Exe">
        <File Id="AppExe" Source="$(PublishDir)\recordingz-capture.exe" KeyPath="yes" />
        <!-- leftovers of the framework-dependent manual install (dlls, json, pdb) next to the single-file exe -->
        <RemoveFile Id="OldDlls" Name="*.dll" On="install" />
        <RemoveFile Id="OldJson" Name="*.json" On="install" />
        <RemoveFile Id="OldPdb" Name="*.pdb" On="install" />
        <RemoveFile Id="QuitRequest" Name="quit.request" On="both" />
        <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
      </Component>
    </ComponentGroup>

<?ifdef SuiteDir?>
    <ComponentGroup Id="Suite" Directory="INSTALLFOLDER">
      <Component Id="ReviewExe">
        <File Id="ReviewExe" Source="$(SuiteDir)\recordingz-review.exe" KeyPath="yes" />
      </Component>
      <Component Id="UvExe">
        <File Id="UvExe" Source="$(SuiteDir)\uv.exe" KeyPath="yes" />
      </Component>
      <Files Directory="TRANSCRIBEFOLDER" Include="$(SuiteDir)\transcribe\**" />
      <Files Directory="FFMPEGFOLDER" Include="$(SuiteDir)\ffmpeg\**" />
    </ComponentGroup>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="ReviewShortcut">
        <Shortcut Id="ReviewStartMenu" Name="recordingz - prepisy" Description="Transcripts, speakers and minutes"
                  Target="[INSTALLFOLDER]recordingz-review.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\recordingz\capture" Name="ReviewShortcut" Type="integer" Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>
<?endif?>

    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut">
        <Shortcut Id="StartMenu" Name="recordingz - capture" Description="Records Teams calls and meetings"
                  Target="[INSTALLFOLDER]recordingz-capture.exe" WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\recordingz\capture" Name="StartMenuShortcut" Type="integer" Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- the same name as the shortcut of the manual install, so it is replaced and not doubled -->
    <StandardDirectory Id="StartupFolder">
      <Component Id="AutostartShortcut">
        <Shortcut Id="Autostart" Name="recordingz - capture" Target="[INSTALLFOLDER]recordingz-capture.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RegistryValue Root="HKCU" Key="Software\recordingz\capture" Name="AutostartShortcut" Type="integer" Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- Only on a fresh install: an upgrade skips the folder page and must not hand the app a default that would
         replace the folder set in Nastavení. Uninstall leaves the folder unless it is empty. -->
    <Component Id="RecordingsFolder" Directory="OUTDIR" Guid="3c9a7e52-1d4f-4b8e-a6f0-5e2b9d7c4a18"
               Condition="NOT WIX_UPGRADE_DETECTED">
      <CreateFolder />
      <RegistryValue Root="HKCU" Key="Software\recordingz\capture" Name="OutDir" Type="string" Value="[OUTDIR]"
                     KeyPath="yes" />
    </Component>

    <Feature Id="Main">
      <ComponentGroupRef Id="App" />
      <ComponentRef Id="RecordingsFolder" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="AutostartShortcut" />
<?ifdef SuiteDir?>
      <ComponentGroupRef Id="Suite" />
      <ComponentRef Id="ReviewShortcut" />
<?endif?>
    </Feature>

    <!-- Ask a running app to quit and wait for it (90 s: a finishing recording writes its mix first). Runs
         whatever version is installed, also the capture app of teamsrec 1.x in its own folder (the suite was called
         teamsrec until 2.0). No square brackets in the
         script: MSI would read them as property references. A Property, not SetProperty: a custom action's
         target is limited to 255 characters, a property value is not; WixQuietExec formats it at run time. -->
    <Property Id="WixQuietExecCmdLine" Value="&quot;[System64Folder]WindowsPowerShell\v1.0\powershell.exe&quot; -NoProfile -NonInteractive -ExecutionPolicy Bypass -Command &quot;function running($n, $exe) { @(Get-Process $n -ErrorAction SilentlyContinue | Where-Object { $_.Path -eq $exe }).Count -gt 0 }; function quit($d, $n) { $exe = Join-Path $d ($n + '.exe'); $req = Join-Path $d 'quit.request'; if (running $n $exe) { New-Item -ItemType File -Force -Path $req | Out-Null; $t = 0; while ((running $n $exe) -and $t -lt 90) { Start-Sleep -Seconds 1; $t++ }; Remove-Item -Force -ErrorAction SilentlyContinue -Path $req; if (running $n $exe) { exit 1 } } }; quit '[INSTALLFOLDER]' 'recordingz-capture'; quit '[LocalAppDataFolder]Programs	eamsrec-capture' 'teamsrec-capture'; exit 0&quot;" />
    <CustomAction Id="QuitRunningApp" BinaryRef="Wix4UtilCA_X64" DllEntry="WixQuietExec" Execute="immediate"
                  Return="check" />

    <CustomAction Id="LaunchApp" Directory="INSTALLFOLDER" ExeCommand="&quot;[INSTALLFOLDER]recordingz-capture.exe&quot;"
                  Return="asyncNoWait" Impersonate="yes" />

    <InstallExecuteSequence>
      <Custom Action="QuitRunningApp" Before="InstallValidate" />
      <Custom Action="LaunchApp" After="InstallFinalize" Condition="NOT REMOVE AND LAUNCHAPP = 1" />
    </InstallExecuteSequence>

    <!-- shown when QuitRunningApp fails (exit 1): the app is recording or did not quit -->
    <UI>
      <Error Id="1722" Message="recordingz is recording or did not quit. Run the installer again after the recording (or Quit it from the tray icon)." />
    </UI>

  </Package>
</Wix>
